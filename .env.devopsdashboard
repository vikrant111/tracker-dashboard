# =============================================================================
# DevOps dashboard — configuration and tokens
#
# Everything the /devops board reads from the environment lives in this file and
# nowhere else. The POD board keeps its own settings in `.env.local`; the two
# share a shell, a theme and a login, and nothing else.
#
# Loaded by `src/lib/devops/config.ts` on the server, once per process. Values
# already set on the process always win, so a container's own environment
# overrides anything written here.
#
# Put a REAL token in `.env.devopsdashboard.local` instead of this file —
# that one is git-ignored. This file is committed so a clone runs, which means
# anything in it is public to everyone with the repository.
# =============================================================================

# ---------- Who may open the board -------------------------------------------
# members  everyone signed in            (default)
# admins   admins only
#
# Members need to see whether develop is frozen before they push, which is the
# whole point of the board, so members is the default.
DEVOPS_ACCESS=members

# ---------- GitHub ------------------------------------------------------------
# dry-run  (default) records a freeze on the board, sends NOTHING to GitHub
# live     actually locks and unlocks branches
#
# Anything other than the exact word `live` is a dry run. The failure mode of
# guessing wrong in the other direction is a branch nobody meant to lock.
GITHUB_MODE=dry-run

# API root. Override for GitHub Enterprise, e.g. https://github.acme.com/api/v3
GITHUB_API_URL=https://api.github.com

# Fallback token, used by any repository onboarded without one of its own.
#
# A fine-grained token needs: Contents (read), Pull requests (read), and
# Administration (read and write) on the repositories it freezes. Reading pull
# requests for the sign-off report needs only the first two.
#
# LEAVE BLANK HERE. Put the real value in `.env.devopsdashboard.local`.
GITHUB_TOKEN=

# ---------- Sync --------------------------------------------------------------
# Pages of 100 merged pull requests one `Sync PRs` reads. 5 covers roughly six
# months on a busy repository; raise it for a first import, then put it back.
DEVOPS_SYNC_PAGES=5

# ---------- Tables ------------------------------------------------------------
# Rows a section shows before it pages. Seven keeps a section a glance.
DEVOPS_PAGE_SIZE=7

# ---------- Storage -----------------------------------------------------------
# Shared with the POD board, repeated here because it decides where this board's
# repos, cycles, scope rows and pull requests are written.
#
#   json     (default) files under DB_store/ — nothing installed
#   mongodb  a real cluster, via MONGODB_URI in .env.local
#
# Switching is this one value. Every number is computed from the same code on
# both drivers, so nothing on the board can change shape when you move.
DB_DRIVER=json
