# =============================================================================
# POD Tracker — configuration
#
# Copy to `.env.local` (development) or supply as environment variables in your
# deployment. Everything the app needs is here; nothing else has to be
# configured before it will run.
#
# Anything marked REQUIRED must be set before a production deployment starts.
# Everything else has a working default.
# =============================================================================

# ---------- OpenSearch ------------------------------------------- REQUIRED --
# Where the data lives. Indices are created automatically on first use.
OPENSEARCH_URL=http://localhost:9200

# Leave blank when the security plugin is off (the docker-compose dev setup).
# Set both in production.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Lets several environments share one cluster without colliding.
OPENSEARCH_INDEX_PREFIX=tracker

# ---------- Auth ------------------------------------------------- REQUIRED --
# off      -> no login, everyone is admin. LOCAL DEVELOPMENT ONLY.
# password -> email + password, accounts stored in OpenSearch
# entra    -> Microsoft Entra ID (Azure AD) SSO
# both     -> both offered on the sign-in screen
AUTH_MODE=password

# REQUIRED IN PRODUCTION. Generate with:  openssl rand -base64 32
#
# The app REFUSES TO START in production without a real one, and refuses the
# placeholder below. That is deliberate: session tokens are signed with this,
# so a known value means anybody can forge an admin session.
AUTH_SECRET=change-me-openssl-rand-base64-32

# Needed when running behind a reverse proxy, which is every real deployment.
AUTH_TRUST_HOST=true

# ---------- The first admin ---------------------------------------------------
# Used to create the very first account, automatically, the first time somebody
# tries to sign in — there is nothing to run by hand. Only ever fires when the
# user store is completely empty.
#
# Change the password before anyone else can reach the instance. With
# AUTH_MODE=entra these are ignored: the first person to sign in becomes admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ---------- Entra ID SSO (AUTH_MODE=entra|both) -------------------------------
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# ---------- Azure DevOps ------------------------------------------------------
# Set all three and a POD is created for you on first run, already connected and
# syncing. Two out of three provisions a POD that cannot connect, so the app
# treats a partial set as none.
#
# The PAT needs Work Items (Read) and nothing more.
AZDO_ORG_URL=
AZDO_PROJECT=
AZDO_PAT=

# ---------- Sync --------------------------------------------------------------
# Background poller, in seconds. 0 disables it; the webhook and the manual Sync
# button still work.
SYNC_POLL_SECONDS=120

# Shared secret Azure DevOps Service Hooks must send as ?token=... on the
# webhook URL. Compared in constant time; UNSET REJECTS EVERY WEBHOOK CALL,
# which is the safe default — set it only when you wire the hooks up.
AZDO_WEBHOOK_TOKEN=

# ---------- Weather (optional, cosmetic) --------------------------------------
# The greeting card follows the clock on its own. Set a point here and it also
# follows the real weather, via Open-Meteo — free, no API key, one request every
# fifteen minutes.
#
# Leave blank and NOTHING is fetched. The card never invents conditions it does
# not know.
WEATHER_LAT=
WEATHER_LON=

# ---------------------------------------------------------------------- fonts
# Where the three typefaces come from at build time.
#
#   google  (default) downloads from Google during `next build`, then self-hosts
#   local             uses the .woff2 files committed in src/fonts/files/
#   system            no web fonts at all — the reader's own
#
# Use `local` on a machine behind a TLS-inspecting proxy or an allowlist, where
# the default fails with "unable to get local issuer certificate".
# Refresh the files with `pnpm fonts:vendor` from a machine that can reach Google.
FONT_SOURCE=google
