# ---------- OpenSearch ----------
OPENSEARCH_URL=http://localhost:9200
# Leave blank when security plugin is disabled (brew / docker-compose dev setup)
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=tracker

# ---------- Auth ----------
# off      -> no login, everyone is admin (local dev only)
# password -> email + password, users stored in OpenSearch
# entra    -> Microsoft Entra ID (Azure AD) SSO
# both     -> password AND entra offered on the login screen
AUTH_MODE=password
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# First admin, created by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Entra ID / Azure AD SSO (AUTH_MODE=entra|both)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# ---------- Azure DevOps ----------
# Org URL, e.g. https://dev.azure.com/my-org
AZDO_ORG_URL=
AZDO_PROJECT=
# PAT needs Work Items (Read) scope
AZDO_PAT=

# ---------- Weather (optional) ----------
# The greeting sky follows the clock on its own. Set a point here and it will
# also follow the real weather, via Open-Meteo (free, no API key). Leave blank
# and nothing is fetched — the scene never invents conditions it does not know.
WEATHER_LAT=
WEATHER_LON=

# ---------- Sync ----------
# Background poller. 0 disables it (webhook + manual sync still work).
SYNC_POLL_SECONDS=120
# Shared secret Azure DevOps Service Hooks must send as ?token=... on the webhook URL
AZDO_WEBHOOK_TOKEN=change-me
