# =============================================================================
# POD Tracker — configuration
#
# Copy to `.env.local` (development) or supply as environment variables in your
# deployment. Everything the app needs is here; nothing else has to be
# configured before it will run.
#
# Anything marked REQUIRED must be set before a production deployment starts.
# Everything else has a working default.
# =============================================================================

# ---------- Storage ------------------------------------------------------
# Where the data lives. Two drivers, one interface.
#
#   json      (default) files under DB_store/ — NOTHING installed, no port,
#             no Docker. A clone runs the whole app as-is. This is what makes
#             the project work on a locked-down machine.
#   mongodb   a real cluster, via MONGODB_URI below. For production, or any
#             deployment with more than one server process.
#
# Every number is computed from the same code either way, so switching cannot
# change a figure on the board.
DB_DRIVER=json

# Only for DB_DRIVER=json. Defaults to ./DB_store; point it outside the
# repository to keep real data out of version control.
# DB_STORE_DIR=

# ---------- MongoDB ------------------------ REQUIRED when DB_DRIVER=mongodb --
#   local, nothing installed   mongodb://127.0.0.1:27017   (see pnpm mongo:local)
#   hosted (Atlas, free tier)  mongodb+srv://USER:PASS@cluster.mongodb.net
#
# Collections and indexes are created on first use. In production this MUST be
# set: the app will not fall back to localhost, because in a container that
# means connecting to the container itself.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=pod_tracker
MONGODB_COLLECTION_PREFIX=tracker

# ---------- Auth ------------------------------------------------- REQUIRED --
# off      -> no login, everyone is admin. LOCAL DEVELOPMENT ONLY.
# password -> email + password, accounts stored in OpenSearch
# entra    -> Microsoft Entra ID (Azure AD) SSO
# both     -> both offered on the sign-in screen
AUTH_MODE=password

# REQUIRED IN PRODUCTION. Generate with:  openssl rand -base64 32
#
# The app REFUSES TO START in production without a real one, and refuses the
# placeholder below. That is deliberate: session tokens are signed with this,
# so a known value means anybody can forge an admin session.
AUTH_SECRET=change-me-openssl-rand-base64-32

# Needed when running behind a reverse proxy, which is every real deployment.
AUTH_TRUST_HOST=true

# ---------- The first admin ---------------------------------------------------
# Used to create the very first account, automatically, the first time somebody
# tries to sign in — there is nothing to run by hand. Only ever fires when the
# user store is completely empty.
#
# Change the password before anyone else can reach the instance. With
# AUTH_MODE=entra these are ignored: the first person to sign in becomes admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ---------- Entra ID SSO (AUTH_MODE=entra|both) -------------------------------
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# ---------- Azure DevOps ------------------------------------------------------
# THE TWO LINES THAT MATTER.
#
# A POD named in src/lib/contracts/azure-sources.ts reads its work items from
# Azure on every request and stores nothing at all. Set these two and it starts
# working — everything else about what it reads (which projects, which filters,
# which 365 days) is in that contract file, so this section is about reaching
# the server, not about choosing the work.
#
# The PAT needs Work Items (Read) and nothing more. A POD may carry its own in
# Admin instead, which is what to do when two PODs read different organisations.
AZDO_ORG_URL=https://dev.azure.com/BFLDevOpsOrg
AZDO_PAT=

# Only for a POD that still SYNCS into the store rather than reading live. A
# live POD takes its projects from the contract and ignores this.
AZDO_PROJECT=

# ---------- Sync --------------------------------------------------------------
# Background poller, in seconds. 0 disables it; the webhook and the manual Sync
# button still work.
SYNC_POLL_SECONDS=120

# Shared secret Azure DevOps Service Hooks must send as ?token=... on the
# webhook URL. Compared in constant time; UNSET REJECTS EVERY WEBHOOK CALL,
# which is the safe default — set it only when you wire the hooks up.
AZDO_WEBHOOK_TOKEN=

# ---------- Weather (optional, cosmetic) --------------------------------------
# The greeting card follows the clock on its own. Set a point here and it also
# follows the real weather, via Open-Meteo — free, no API key, one request every
# fifteen minutes.
#
# Leave blank and NOTHING is fetched. The card never invents conditions it does
# not know.
WEATHER_LAT=
WEATHER_LON=

# ---------------------------------------------------------------------- fonts
# Where the typefaces come from at build time.
#
#   local   (default) the .woff2 files committed in src/fonts/files/
#   system            no web fonts at all — the reader's own
#
# NOTHING IS DOWNLOADED, at build time or at run time. There was a `google`
# mode and it is gone: a build that reaches fonts.googleapis.com dies behind a
# TLS-inspecting proxy with "unable to get local issuer certificate", and the
# ~140 KB of typefaces ship with the repository anyway.
#
# `pnpm fonts:vendor` refreshes those files from a machine that can reach
# Google. It is run by hand; the build never does.
FONT_SOURCE=local

# ---------------------------------------------------------------- azure debug
# What the Azure client prints about what it fetched.
#
#   off      (default) silent
#   summary  counts, timings, and which fields came back and how often
#   full     the above, plus one whole work item — REAL titles and names, so
#            fine on a laptop and not in a log somebody else can read
#
# `pnpm azure:probe` does the same on demand, read-only, without waiting for a
# sync — and a sync only fetches what changed, which is often nothing.
AZDO_DEBUG=off
