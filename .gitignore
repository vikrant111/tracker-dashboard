.next
/.next-*
.DS_Store
next-env.d.ts
*.tsbuildinfo


# pnpm
.pnpm-store

# Real secrets for the DevOps board. `.env.devopsdashboard` IS committed — it
# carries the shape and the safe defaults, so a clone runs. The `.local` beside
# it is where a real GITHUB_TOKEN goes, and it never leaves the machine.
# .env.devopsdashboard.local

# Scratch left by `pnpm clear` and the render check.
.render-check

# Local MongoDB data from `pnpm mongo:local`. Never committed.
.mongo-data

# The json driver writes here. The demo data IS committed, deliberately: a
# clone must run with no database. A real deployment either sets
# DB_STORE_DIR outside the repo, or uses DB_DRIVER=mongodb.
# Lock and temp files never are.
DB_store/.*.lock
DB_store/.*.tmp
